# Credenciais da API Telegram (obtenha em my.telegram.org)
API_ID=seu_api_id_aqui
API_HASH=sua_api_hash_aqui

# Nome da sessao (sem extensao, arquivo sera criado em data/)
SESSION_NAME=userbot_session

# Chat ID ou username para onde encaminhar ofertas
# Pode ser 'me' (mensagens salvas), um ID numerico ou @username
FORWARD_TO=me

# Varredura de seguranca (catch-up): recupera ofertas que o push do Telegram
# atrasou/perdeu. Volta completa pelos grupos em ~ (nº grupos x CATCHUP_INTERVAL).
CATCHUP_ENABLED=1
CATCHUP_INTERVAL=1.0
CATCHUP_LIMIT=20
CATCHUP_PRIME_DELAY=60

# Rota WhatsApp (ponte local da sessao do Sol, bridge.js em 127.0.0.1:3001).
# A ponte exige Authorization: Bearer e ROTACIONA o segredo a cada restart, por
# isso o token e lido do arquivo a cada envio. No Docker o compose monta o
# diretorio da sessao em /hermes-wa (somente leitura).
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
# WHATSAPP_BRIDGE_TOKEN_FILE=/hermes-wa/.bridge-token
# WHATSAPP_GROUP_ID=120363428867776994@g.us
# WHATSAPP_MENTION_JID=555195782073@s.whatsapp.net
